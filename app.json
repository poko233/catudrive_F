{
  "expo": {
    "name": "CodigoBaseF",
    "slug": "codigobasef",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "codigobasef",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,

      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CatuDrive utiliza Bluetooth para conectarse con impresoras.",
        "NSBluetoothPeripheralUsageDescription": "CatuDrive utiliza Bluetooth para conectarse con impresoras.",
        "NSLocalNetworkUsageDescription": "CatuDrive utiliza la red local para conectarse con impresoras y servicios autorizados."
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "edgeToEdgeEnabled": true,

      "predictiveBackGestureEnabled": false,

      "package": "com.metasoft.codigobasef",

      "permissions": [
        "android.permission.INTERNET",

        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",

        "android.permission.ACCESS_FINE_LOCATION",

        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",

          "backgroundColor": "#ffffff",

          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "expo-secure-store",

      "@react-native-community/datetimepicker",

      "with-rn-bluetooth-classic",

      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],

      "./plugins/withAndroidCoreLibraryDesugaring"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "QR_SECRET_KEY": "TU_QR_SECRET_KEY",

      "router": {},

      "eas": {
        "projectId": "4d6e8a76-fc5c-43d0-a17c-6bcbf4a310f6"
      }
    }
  }
}